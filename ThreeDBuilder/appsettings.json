{
  "app": {
    "name": "3D Builder",
    "version": "1.0.0"
  },
  "storage": {
    "configFileName": "config.enc",
    "libraryFileName": "library.json",
    "defaultModelsDir": "%USERPROFILE%/Documents/3D Builder/Models",
    "texturesSubdir": "textures"
  },
  "providers": {
    "tripo": { "enabled": true, "freeTier": true },
    "huggingface": { "enabled": true, "freeTier": true },
    "gemini": { "enabled": true, "freeTier": false },
    "meshy": { "enabled": true, "freeTier": false },
    "rodin": { "enabled": true, "freeTier": false }
  },
  "blender": {
    "cliArgs": [ "--background", "--python" ]
  }
}
