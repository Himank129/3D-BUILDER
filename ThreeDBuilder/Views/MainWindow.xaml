<Window x:Class="ThreeDBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="3D Builder"
        Height="760" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#252526" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="3D  Builder" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,16,0"/>
                <TextBlock Text="BYOK 3D Generation — .glb · .fbx · .py" Foreground="#AAAAAA" FontSize="12"/>
                <Border VerticalAlignment="Center" Width="1" Height="20" Background="#333" Margin="16,0"/>
                <TextBlock x:Name="VaultStatusText" Foreground="#FFCC00" FontSize="12" FontWeight="Bold" Text="Vault: locked"/>
                <TextBlock x:Name="AppVersionText" Foreground="#AAAAAA" FontSize="11" Margin="16,0,0,0" Text="v1.0.0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Sidebar -->
            <Border Width="220" Background="#1e1e1e">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="NAVIGATION" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="16,0,16,12"/>

                    <Button x:Name="BtnUnlock" Content="Unlock Vault" Foreground="White" Background="#333333" BorderBrush="Transparent"
                            Margin="12,4" Padding="10,8" HorizontalAlignment="Stretch" Click="BtnUnlock_Click"/>
                    <Button x:Name="BtnGenerate" Content="Generate" Foreground="White" Background="#007acc" BorderBrush="Transparent"
                            Margin="12,4" Padding="10,8" HorizontalAlignment="Stretch" Click="BtnGenerate_Click"/>
                    <Button x:Name="BtnLibrary" Content="Library" Foreground="White" Background="#333333" BorderBrush="Transparent"
                            Margin="12,4" Padding="10,8" HorizontalAlignment="Stretch" Click="BtnLibrary_Click"/>
                    <Button x:Name="BtnSettings" Content="Settings" Foreground="White" Background="#333333" BorderBrush="Transparent"
                            Margin="12,4" Padding="10,8" HorizontalAlignment="Stretch" Click="BtnSettings_Click"/>

                    <TextBlock Text="EXPORTED MODELS LIVE ON DISK" Foreground="#888888" FontSize="10" FontWeight="SemiBold"
                               Margin="16,24,16,4" TextWrapping="Wrap"/>
                    <TextBlock Text="%USERPROFILE%/Documents/3D Builder/Models" Foreground="#666666" FontSize="11" Margin="16,0,16,0" TextWrapping="Wrap"/>
                    <TextBlock Text="%APPDATA%/3D Builder/config.enc (encrypted)" Foreground="#666666" FontSize="11" Margin="16,8,16,16" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel">
                        <!-- Generate view -->
                        <StackPanel x:Name="GeneratePanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Generate 3D Model" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="AI Provider" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbProvider" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id" SelectionChanged="CmbProvider_SelectionChanged" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Input Mode" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <RadioButton Content="Text → 3D" GroupName="InputMode" Foreground="White" IsChecked="True"/>
                                    <RadioButton Content="Image → 3D" GroupName="InputMode" Foreground="White" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Prompt" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtPrompt" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     Height="90" Background="#1e1e1e" Foreground="White" BorderBrush="#333333" Margin="0,0,0,8"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtImagePath" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"
                                         Background="#1e1e1e" Foreground="White" BorderBrush="#333333" Margin="0,0,8,0" PlaceholderText="Reference image (optional)"/>
                                <Button Content="Browse" Width="80" Click="BtnBrowseImage_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Topology" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbTopology" SelectedValue="{Binding Topology}" Background="#1e1e1e" Foreground="White" BorderBrush="#333333">
                                        <ComboBoxItem Content="Quad (default)" Tag="quad"/>
                                        <ComboBoxItem Content="Triangle" Tag="triangle"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="Polycount" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbPolycount" SelectedValue="{Binding Polycount}" Background="#1e1e1e" Foreground="White" BorderBrush="#333333">
                                        <ComboBoxItem Content="Low (10k)" Tag="low"/>
                                        <ComboBoxItem Content="Medium (30k)" Tag="medium"/>
                                        <ComboBoxItem Content="High (100k)" Tag="high"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="Export" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbFormat" SelectedValue="{Binding Format}" Background="#1e1e1e" Foreground="White" BorderBrush="#333333">
                                        <ComboBoxItem Content=".glb" Tag="glb"/>
                                        <ComboBoxItem Content=".fbx" Tag="fbx"/>
                                        <ComboBoxItem Content=".py (Blender script)" Tag="py"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Button Content="Generate 3D Model" Height="40" Background="#007acc" BorderBrush="Transparent" Foreground="White"
                                    FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" Click="BtnGenerateModel_Click" IsEnabled="{Binding CanGenerate}"/>

                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtStatus" Text="{Binding Status}" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="PrgProgress" Value="{Binding Progress}" Height="8" Background="#333333" Foreground="#007acc" Margin="0,0,0,12"/>
                            </StackPanel>

                            <Border Background="#252526" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Last Generated Model" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtLastModel" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button x:Name="BtnOpenLastInBlender" Content="Open in Blender" Click="BtnOpenLastInBlender_Click" Background="#007acc" BorderBrush="Transparent"
                                            Foreground="White" Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Library view -->
                        <StackPanel x:Name="LibraryPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Model Library" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Lightweight index: Documents/3D Builder/library.json" Foreground="#888888" FontSize="11" Margin="0,0,0,12"/>

                            <ListView x:Name="LibraryList" ItemsSource="{Binding Library.Models}" Height="420"
                                      Background="#252526" BorderBrush="#333333" Foreground="White">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="#1e1e1e"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Padding" Value="10"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="4" BorderBrush="#333333" Background="#252526" Padding="10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Prompt}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Provider}" Foreground="#007acc" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="#AAAAAA" FontSize="10" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#666666" FontSize="9" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open in Blender" Width="110" Height="28" Margin="8,0,0,0"
                                                        Background="#007acc" BorderBrush="Transparent" Foreground="White" Click="BtnOpenLibraryItem_Click"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2" Content="Remove" Width="70" Height="28" Margin="8,0,0,0"
                                                        Background="#333333" BorderBrush="Transparent" Foreground="White" Click="BtnRemoveLibraryItem_Click"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Refresh Library" Click="BtnRefreshLibrary_Click" Background="#333333" BorderBrush="Transparent"
                                    Foreground="White" Margin="0,12,0,0" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Settings view -->
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="Settings" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Vault Password (encrypts config.enc)" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="PwdVault" PasswordChanged="PwdVault_PasswordChanged" Background="#1e1e1e" Foreground="White" BorderBrush="#333333" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtVaultHint" Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap">
                                        Set a vault password on first run. Your BYOK API keys and settings are stored encrypted in %APPDATA%/3D Builder/config.enc.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="BYOK API Keys (stored encrypted)" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="ApiKeyList" Margin="0,0,0,10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="10" Background="#1e1e1e">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Id}" Foreground="#888888" FontSize="10" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <PasswordBox Grid.Column="1" Width="220" Margin="12,0,0,0" Background="#0d0d0d" Foreground="White" BorderBrush="#333333"
                                                                     Tag="{Binding Id}" PasswordChanged="ApiKeyPassword_PasswordChanged"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="TxtApiStatus" Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#252526" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Blender Integration" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBlenderPath" IsReadOnly="True" Background="#1e1e1e" Foreground="White" BorderBrush="#333333"
                                                 PlaceholderText="C:\Program Files\Blender Foundation\Blender 4.x\blender.exe"/>
                                        <Button Grid.Column="1" Content="Browse" Width="80" Margin="8,0,0,0" Click="BtnBrowseBlender_Click"/>
                                    </Grid>
                                    <Button Content="Test Blender" Click="BtnTestBlender_Click" Background="#007acc" BorderBrush="Transparent" Foreground="White" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtBlenderStatus" Foreground="#AAAAAA" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#252526" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Models Folder &amp; Defaults" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtModelsDir" IsReadOnly="True" Background="#1e1e1e" Foreground="White" BorderBrush="#333333"
                                                 PlaceholderText="Documents/3D Builder/Models"/>
                                        <Button Grid.Column="1" Content="Browse" Width="80" Margin="8,0,0,0" Click="BtnBrowseModelsDir_Click"/>
                                    </Grid>
                                    <Button Content="Save Defaults" Click="BtnSaveDefaults_Click" Background="#007acc" BorderBrush="Transparent" Foreground="White" Width="110" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtDefaultsStatus" Foreground="#AAAAAA" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    <Window.Resources>
    </Window.Resources>
</Window>
